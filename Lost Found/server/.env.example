# Server Port
PORT=5000

# MongoDB URI (Local or MongoDB Atlas cloud connection string)
# Example local: mongodb://127.0.0.1:27017/campus_lost_found
# Example cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/campus_lost_found?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found

# Environment Mode
NODE_ENV=development
